# Copy this file to .env (gitignored) and fill it in. Never commit .env.

# Claude API key from https://platform.claude.com/ (not needed for `study demo` or `study eval`).
ANTHROPIC_API_KEY=

# MyCourses: Calendar > Export calendar > "Get calendar URL". The URL contains a private token:
# it stays in this file, is never logged, and is never sent to the model. A local .ics path works too.
STUDY_DEADLINES_ICS=

# Timetable: an .ics URL or file (e.g. a Sisu export), or a YAML file like docs/timetable.example.yaml.
STUDY_TIMETABLE=

# Optional settings (defaults shown)
# STUDY_MODEL=claude-opus-5-5
# STUDY_EFFORT=medium            # low | medium | high | xhigh | max
# STUDY_MAX_ROUNDS=8             # hard limit on model calls per question
# STUDY_DAY_START=09:00          # study window used by the planner
# STUDY_DAY_END=21:00
# STUDY_DAILY_CAP_MIN=300        # max planned study minutes per day
# STUDY_MAX_BLOCK_MIN=90
# STUDY_SYNC_MAX_AGE_HOURS=6     # re-download calendars when the cache is older than this
# STUDY_EUR_PER_USD=0.86         # for cost reporting in euros
# STUDY_DATA_DIR=~/.study-agent  # SQLite database and calendar cache
